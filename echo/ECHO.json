    {
      "parameters": {
        "jsCode": "const out = ($json.output || '').toString();\nconst start = out.indexOf('```email');\nlet emailRequested = false, to = '', subject = '', body = '', message = out;\nif (start !== -1) {\n  const after = out.slice(start + 8);\n  const end = after.indexOf('```');\n  const block = end === -1 ? after : after.slice(0, end);\n  const bodyLines = [];\n  let inBody = false;\n  for (const raw of block.split('\\n')) {\n    const line = raw.trim();\n    const low = line.toLowerCase();\n    if (!inBody && low.startsWith('to:')) to = raw.slice(raw.indexOf(':') + 1).trim();\n    else if (!inBody && low.startsWith('subject:')) subject = raw.slice(raw.indexOf(':') + 1).trim();\n    else if (!inBody && low.startsWith('body:')) { inBody = true; bodyLines.push(raw.slice(raw.indexOf(':') + 1)); }\n    else if (inBody) bodyLines.push(raw);\n  }\n  body = bodyLines.join('\\n').trim();\n  emailRequested = to.length > 0;\n  const fenceEnd = end === -1 ? out.length : start + 8 + end + 3;\n  message = (out.slice(0, start) + out.slice(fenceEnd)).trim();\n}\nreturn [{ json: Object.assign({}, $json, { output: message, emailRequested, email_to: to, email_subject: subject, email_body: body }) }];"
      },

# Local development uses SQLite. Copy this file to `.env`:
#   cp .env.example .env
DATABASE_URL="file:./dev.db"

# Public base URL used for sitemap/robots/canonical/JSON-LD.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Production (PostgreSQL) ---
# To switch to Postgres:
#   1. In prisma/schema.prisma set `datasource db { provider = "postgresql" }`
#   2. Set DATABASE_URL below to your Postgres connection string, e.g.
# DATABASE_URL="postgresql://user:password@localhost:5432/propfirm?schema=public"

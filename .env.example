# JARVIS & ECHO 2.0 - API keys
# Copy this file to ".env" and paste your own keys (the setup scripts do this
# for you automatically). Never commit your real .env to GitHub.

# --- LiveKit (real-time room connection) ---
# Get these from https://cloud.livekit.io  ->  Settings  ->  Keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# --- Deepgram (speech-to-text) ---
# Get this from https://console.deepgram.com
DEEPGRAM_API_KEY=your_deepgram_api_key

# --- OpenAI (GPT-4o brain + text-to-speech voice) ---
# Get this from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key

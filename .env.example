# JARVIS & ECHO 2.0 — configuration
# Copy this file to ".env" and paste your key. Never commit your real .env.

# --- Brain: route through ECHO (recommended) OR call Anthropic directly ---
# ECHO is the multi-provider proxy (see ./echo). When ECHO_BASE_URL is set,
# JARVIS sends its thinking to ECHO instead of straight to Anthropic.
# Leave ECHO_BASE_URL empty to use Anthropic directly (single-provider mode).
ECHO_BASE_URL=
# JARVIS presents this to ECHO as its bearer token (ECHO's master key).
ECHO_API_KEY=
# Which ECHO alias/tier to request. Defaults to the funded Gemini alias.
ECHO_MODEL=gemini-3.1-pro-preview

# Direct-Anthropic mode (used only when ECHO_BASE_URL is empty).
# Get a key from https://console.anthropic.com  ->  API Keys
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Which Claude model to use directly. Sonnet 4.6 default; Haiku 4.5 faster.
#   claude-sonnet-4-6            (smart, balanced)
#   claude-haiku-4-5-20251001   (fast, cheap)
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Wake word ("Hey JARVIS") ---
# Comma-separated phrases. Leave EMPTY (WAKE_PHRASES=) for always-on.
WAKE_PHRASES=hey jarvis,jarvis
# How long JARVIS stays awake after the last thing you said, in seconds.
WAKE_WINDOW_SECONDS=15

# --- Local voice stack (no keys needed) ---
# Whisper model size: tiny | base | small | medium | large-v3 (bigger = slower, better)
WHISPER_MODEL=base
# Kokoro voice id (e.g. af_heart, am_adam, bf_emma — see the Kokoro voice list)
KOKORO_VOICE=af_heart

# --- Cross-session memory (remember / recall tools) ---
# When enabled, JARVIS can save facts and recall them in later conversations.
MEMORY_ENABLED=true
# Backend: "obsidian" (local markdown vault, no deps) or "supabase" (pgvector).
MEMORY_BACKEND=obsidian
# Obsidian backend: where the markdown notes live (git-ignored).
OBSIDIAN_VAULT_PATH=./memory_vault
# Supabase backend (only when MEMORY_BACKEND=supabase). See memory/schema.sql.
SUPABASE_URL=
SUPABASE_KEY=
MEMORY_TABLE=memories
# Embeddings for the supabase backend: "hashing" (offline) or "openai".
EMBEDDINGS_PROVIDER=hashing
# EMBEDDINGS_BASE_URL / EMBEDDINGS_API_KEY / EMBEDDINGS_MODEL / EMBEDDINGS_DIM
# configure the openai-compatible embeddings endpoint (can point at ECHO).

# --- MCP agents (connect JARVIS to Model Context Protocol servers) ---
# When enabled, JARVIS loads tools from the configured MCP servers and can use
# them mid-conversation (filesystem, web, databases, etc.).
MCP_ENABLED=false
# Inline JSON of servers (Claude-Desktop "mcpServers" shape), OR point
# MCP_CONFIG_FILE at a JSON file like the included mcp_servers.example.json.
# MCP_SERVERS={"mcpServers": {"filesystem": {"command": "npx", "args": ["-y", "@modelcontextprotocol/server-filesystem", "/data"]}}}
MCP_CONFIG_FILE=

# --- Misc ---
ASSISTANT_NAME=JARVIS
# Desktop webcam index for the vision tool (0 = default camera).
CAMERA_INDEX=0

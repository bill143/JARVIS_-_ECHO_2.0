# JARVIS · Alloy — API keys
# Copy this to ".env" and paste your keys (the setup script does this for you).
# Never commit your real .env.

# --- Stream (real-time video + audio edge) ---
# Free: 333,000 participant-minutes/month. https://getstream.io/try-for-free/
STREAM_API_KEY=your_stream_api_key
STREAM_API_SECRET=your_stream_api_secret

# --- Anthropic (Claude — the brain AND the vision) ---
# https://console.anthropic.com  (key starts with sk-ant-)
ANTHROPIC_API_KEY=your_anthropic_api_key

# --- Deepgram (speech-to-text) ---
# https://console.deepgram.com
DEEPGRAM_API_KEY=your_deepgram_api_key

# --- ElevenLabs (text-to-speech voice) ---
# https://elevenlabs.io
ELEVENLABS_API_KEY=your_elevenlabs_api_key
